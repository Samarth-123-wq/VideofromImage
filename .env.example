# Paste keys here, then copy to .env
# Google AI Studio (Gemini) — free image quota, used first
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Hugging Face — fallback (FLUX schnell, free tier)
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Pollinations — last fallback if you have a token
POLLINATIONS_API_KEY=

# YouTube Data API OAuth client (Google Cloud Console)
# Application type: Web, authorized JS origin: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
